# Server
PORT=5000
NODE_ENV=production

# Database — replace with your Atlas URI
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/DocuGen?retryWrites=true&w=majority

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRE=1d

# Google OAuth — must match exactly what's in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/auth/google/callback

# Frontend URL (for CORS)
FRONTEND_URL=https://your-app.vercel.app

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads/

# Upstash Redis REST (for stateless cache + rate limiting)
UPSTASH_REDIS_REST_URL=https://<your-upstash-rest-url>
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# BullMQ / Redis TCP connection (for queue workers)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_URL=rediss://default:<token>@<host>:6380

# OpenAI
OPENAI_API_KEY=YOUR_KEY
