# Server
PORT=5000
NODE_ENV=production

# Database — replace with your Atlas URI
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/DocuGen?retryWrites=true&w=majority

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRE=1d

# Google OAuth — must match exactly what's in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-backend.railway.app/api/auth/google/callback

# Frontend URL (for CORS)
FRONTEND_URL=https://your-app.vercel.app

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads/
